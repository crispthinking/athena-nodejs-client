{
  "name": "athena-opentelemetry",
  "version": "1.0.0",
  "description": "Exporting Athena SDK traces and metrics with OpenTelemetry",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --import ./instrumentation.js index.js"
  },
  "dependencies": {
    "@crispthinking/athena-classifier-sdk": "file:../../",
    "@opentelemetry/api": "^1.9.1",
